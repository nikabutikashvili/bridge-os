NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://bridge_os:bridge_os@localhost:5432/bridge_os
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_STORAGE_ROOT=.data/documents

# Required only by `pnpm extract ...` and `pnpm fixtures:ingest`.
EXTRACTION_MODEL_PROVIDER=openai
EXTRACTION_MODEL=gpt-5.4-mini
EXTRACTION_MODEL_MAX_OUTPUT_TOKENS=32000
OPENAI_API_KEY=
# Optional for an OpenAI-compatible gateway or proxy:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Required only for the destructive local reset command:
# ALLOW_DATABASE_RESET=bridge-os-local-reset

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
