{
  "name": "@bridge-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node -r ../../scripts/register-env.cjs --import tsx --watch src/server.ts",
    "extract": "node -r ../../scripts/register-env.cjs --import tsx src/cli/extract-document.ts",
    "fixtures:ingest": "node -r ../../scripts/register-env.cjs --import tsx src/cli/ingest-fixtures.ts",
    "lint": "eslint .",
    "start": "node -r ../../scripts/register-env.cjs dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bridge-os/contracts": "workspace:*",
    "@bridge-os/db": "workspace:*",
    "@fastify/multipart": "^10.1.0",
    "@napi-rs/canvas": "^1.0.6",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "zod": "^3.24.2"
  }
}
